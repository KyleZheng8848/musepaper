# Optional: only needed when publishing releases or wallpaper packs to your OSS bucket.
# Copy to .env.local and supply your own values. Never commit .env.local.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
MUSEPAPER_OSS_TARGET=oss://your-bucket/Musepaper/
MUSEPAPER_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
MUSEPAPER_DOWNLOAD_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/Musepaper/
